# Copie para .env e preencha. NUNCA suba o .env para o GitHub.
# --- IA da Oracle (os MESMOS valores do VinaCare/StudentMedical) ---
OCI_USER=ocid1.user.oc1..
OCI_FINGERPRINT=aa:bb:cc:...
OCI_TENANCY=ocid1.tenancy.oc1..
OCI_REGION=sa-saopaulo-1
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..
OCI_KEY_B64=
OCI_KEY_CONTENT=
# --- Voz neural Azure (necessaria para a voz em espanhol do Paraguai; a da Oracle so fala portugues) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
# --- Mercado Pago (Suas integracoes > Credenciais de producao > Access Token) ---
MP_ACCESS_TOKEN=
# Suas integracoes > Webhooks > "Assinatura secreta" (evento: Planos e assinaturas)
MP_WEBHOOK_SECRET=
# --- VIP ---
HP_VIP_PRECO=29.90
HP_LIMITE_GRATIS=15
# Para onde o aluno volta depois de pagar
HP_APP_URL=https://leonardogmendoza.github.io/HablaPY/demo/
# Senha para cadastrar as aulas ao vivo (invente uma longa)
HP_ADMIN_TOKEN=
# --- Servidor ---
HABLAPY_DATA_DIR=./data
HP_ORIGENS=http://localhost:5173,http://localhost:8000,https://leonardogmendoza.github.io
